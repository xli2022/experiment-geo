{
  "name": "experiment-geo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A world-exploration game built on OpenStreetMap data",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node test/smoke.mjs"
  },
  "dependencies": {
    "3d-tiles-renderer": "^0.5.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/three": "^0.185.4",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
