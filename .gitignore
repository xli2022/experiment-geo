node_modules/
dist/
*.local
.DS_Store

# Baked 3D Tiles ARE committed, deliberately.
#
# They are build artifacts and tools/bake.sh plus a pinned extract remains the
# source of truth for regenerating them. But after compression the whole of
# Monaco is ~37 MB, which is small enough to commit — and committing it is what
# lets GitHub Pages deploy a working world straight from a push, with no Java,
# no 478 MB OSM2World download, and no multi-minute bake in CI.
#
# The tradeoff: every re-bake adds another copy to history. Re-bake when the
# world actually needs to change, not casually. If a future world gets large
# enough that this hurts, move the tiles to Cloudflare R2 and point
# VITE_TILESET_URL at it — that is the escape hatch the config was built for.

# OSM2World distribution and OSM extracts — downloaded, not authored.
vendor/

# Screenshots and scratch captures
*.png

# Intermediate capture artifacts. ortho.png is promoted into public/tiles/<world>/
# by tools/project-ortho.py once it has been projected; the copy at the repo
# root is scratch.
/ortho.png
/ortho.json
/*.png

# Python bytecode from the tools/
__pycache__/
*.pyc

# Diagnostic harness output (test/_*.mjs) — screenshots and error dumps.
*-errors.txt
*.png
